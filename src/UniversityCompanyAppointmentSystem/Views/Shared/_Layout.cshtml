@{
    // ViewBag.CurrentAccountType is set by CompanyBaseController / UniversityBaseController
    // (or manually in shared controllers) to "Company", "University", or left null if nobody is logged in.
    string? accountType = ViewBag.CurrentAccountType as string;
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    int unreadCount = ViewBag.UnreadNotificationCount is int n ? n : 0;

    // Small local helper: returns "active" when the current page belongs to the given controller,
    // so the matching sidebar link can be highlighted.
    string ActiveIf(string controllerName) => currentController.Equals(controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DentLink</title>
    <link rel="icon" type="image/svg+xml" href="~/images/dentlink-logo.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="page-enter">
    <!-- Top navigation bar: shown on every page -->
    <nav class="navbar navbar-expand-sm topbar mb-0">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/dentlink-logo.svg" alt="" class="navbar-brand-logo" width="32" height="32" />
                <span>DentLink</span>
            </a>

            @if (accountType != null)
            {
                <ul class="navbar-nav flex-row ms-auto align-items-center gap-1">
                    @if (accountType != "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link topbar-icon-btn position-relative"
                               asp-controller="Notifications"
                               asp-action="Index"
                               title="Notifications"
                               aria-label="Notifications@(unreadCount > 0 ? $", {unreadCount} unread" : "")">
                                @await Html.PartialAsync("_NavIcon", "notifications")
                                @if (unreadCount > 0)
                                {
                                    <span class="topbar-badge">@unreadCount</span>
                                }
                            </a>
                        </li>
                    }
                    <li class="nav-item me-2">
                        <span class="nav-link topbar-account">@ViewBag.CurrentAccountName (@accountType)</span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn topbar-icon-btn topbar-logout-btn"
                                    title="Logout"
                                    aria-label="Logout">
                                @await Html.PartialAsync("_NavIcon", "logout")
                            </button>
                        </form>
                    </li>
                </ul>
            }
            else
            {
                <ul class="navbar-nav flex-row ms-auto">
                    <li class="nav-item me-2"><a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="nav-item"><a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Register">Register</a></li>
                </ul>
            }
        </div>
    </nav>

    @if (accountType == "Company")
    {
        <div class="app-layout">
            <!-- Company sidebar navigation -->
            <nav class="sidebar py-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("CompanyDashboard")" asp-controller="CompanyDashboard" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "dashboard")
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("Employees")" asp-controller="Employees" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "employees")
                            <span>Employees</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Employees" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "book")
                            <span>Book Appointment</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("Appointments")" asp-controller="Appointments" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "appointments")
                            <span>Appointments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("Notifications")" asp-controller="Notifications" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "notifications")
                            <span>Notifications</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <main class="main-content animate-fade-in">
                @await Html.PartialAsync("_StatusMessages")
                @RenderBody()
            </main>
        </div>
    }
    else if (accountType == "University")
    {
        <div class="app-layout">
            <!-- University sidebar navigation -->
            <nav class="sidebar py-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("UniversityDashboard")" asp-controller="UniversityDashboard" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "dashboard")
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("AppointmentSlots")" asp-controller="AppointmentSlots" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "slots")
                            <span>Appointment Slots</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("Appointments")" asp-controller="Appointments" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "appointments")
                            <span>Appointments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="UniversityDashboard" asp-action="Companies">
                            @await Html.PartialAsync("_NavIcon", "companies")
                            <span>Companies</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("Notifications")" asp-controller="Notifications" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "notifications")
                            <span>Notifications</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <main class="main-content animate-fade-in">
                @await Html.PartialAsync("_StatusMessages")
                @RenderBody()
            </main>
        </div>
    }
    else if (accountType == "Admin")
    {
        <div class="app-layout">
            <nav class="sidebar py-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("AdminDashboard")" asp-controller="AdminDashboard" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "dashboard")
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("AdminUniversities")" asp-controller="AdminUniversities" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "universities")
                            <span>Universities</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("AdminCompanies")" asp-controller="AdminCompanies" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "companies")
                            <span>Companies</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("AdminEmployees")" asp-controller="AdminEmployees" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "employees")
                            <span>Employees</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("AdminAppointments")" asp-controller="AdminAppointments" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "appointments")
                            <span>Appointments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("AdminReports")" asp-controller="AdminReports" asp-action="Index">
                            @await Html.PartialAsync("_NavIcon", "reports")
                            <span>Reports</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <main class="main-content animate-fade-in">
                @await Html.PartialAsync("_StatusMessages")
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="container animate-fade-in">
            @await Html.PartialAsync("_StatusMessages")
            @RenderBody()
        </main>
    }

    <!-- Simple loading overlay, shown briefly while a form is submitting (see site.js) -->
    <div id="page-loading-overlay">
        <div class="loading-tooth" aria-hidden="true">
            <img src="~/images/dentlink-logo.svg" alt="" width="56" height="56" />
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
