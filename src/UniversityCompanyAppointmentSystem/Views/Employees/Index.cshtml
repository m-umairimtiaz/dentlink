@model EmployeeListViewModel
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Employees</h2>
    <a class="btn btn-brand" asp-action="Create">+ Add Employee</a>
</div>

<!-- Search form: a simple GET request so the search term stays in the URL and can be bookmarked/refreshed -->
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or employee number..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-link">Clear</a>
        </div>
    }
</form>

<!-- This form wraps the whole table: checking boxes and clicking "Book Appointment" sends the
     selected employee IDs to Appointments/Book as a normal GET request (employeeIds=1&employeeIds=2...) -->
<form method="get" asp-controller="Appointments" asp-action="Book" id="booking-form">
    <div class="card">
        <div class="card-body p-0">
            @if (Model.Employees.Count == 0)
            {
                <p class="text-muted p-3 mb-0">No employees found. Click "Add Employee" to create one.</p>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:2rem"><input type="checkbox" id="select-all" /></th>
                            <th>Employee #</th>
                            <th>Full Name</th>
                            <th>Civil ID</th>
                            <th>Phone</th>
                            <th>Department</th>
                            <th>Job Title</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Employees)
                        {
                            <tr>
                                <td><input type="checkbox" class="employee-checkbox" name="employeeIds" value="@employee.EmployeeId" /></td>
                                <td>@employee.EmployeeNumber</td>
                                <td>@employee.FullName</td>
                                <td>@employee.CivilId</td>
                                <td>@employee.PhoneNumber</td>
                                <td>@employee.Department</td>
                                <td>@employee.JobTitle</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@employee.EmployeeId">Edit</a>
                                    <button type="submit" form="delete-form-@employee.EmployeeId" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this employee?');">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success-brand" id="book-selected-btn">Book Appointment for Selected Employees</button>
    </div>
</form>

<!-- One tiny hidden delete form per row (kept outside the main form since HTML forms cannot be nested) -->
@foreach (var employee in Model.Employees)
{
    <form id="delete-form-@employee.EmployeeId" asp-action="Delete" asp-route-id="@employee.EmployeeId" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>
}

@section Scripts {
    <script>
        // "Select all" checkbox toggles every employee row checkbox at once.
        document.getElementById('select-all').addEventListener('change', function () {
            document.querySelectorAll('.employee-checkbox').forEach(cb => cb.checked = this.checked);
        });

        // Stop the booking form from submitting with zero employees selected.
        document.getElementById('booking-form').addEventListener('submit', function (e) {
            var anyChecked = document.querySelectorAll('.employee-checkbox:checked').length > 0;
            if (!anyChecked) {
                e.preventDefault();
                alert('Please select at least one employee before booking an appointment.');
            }
        });
    </script>
}
