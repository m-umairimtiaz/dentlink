@model AdminUniversityDetailsViewModel
@{
    ViewData["Title"] = Model.University.UniversityName;
    var u = Model.University;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@u.UniversityName</h2>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-brand" asp-action="Edit" asp-route-id="@u.UniversityId">Edit</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">University Details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Contact</dt><dd class="col-sm-8">@u.ContactPersonName</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@u.Email</dd>
                    <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@u.PhoneNumber</dd>
                    <dt class="col-sm-4">Created</dt><dd class="col-sm-8">@u.CreatedAt.ToString("dd MMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="row g-3">
            <div class="col-6"><div class="stat-card"><div class="stat-number">@Model.SlotCount</div><div class="stat-label">Slots</div></div></div>
            <div class="col-6"><div class="stat-card"><div class="stat-number">@Model.AppointmentCount</div><div class="stat-label">Appointments</div></div></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white">Recent Slots</div>
            <div class="card-body p-0">
                @if (Model.Slots.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No slots.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Date</th><th>Time</th><th>Max</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var slot in Model.Slots)
                            {
                                <tr>
                                    <td>@slot.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@slot.StartTime.ToString("hh:mm tt") - @slot.EndTime.ToString("hh:mm tt")</td>
                                    <td>@slot.MaximumEmployees</td>
                                    <td>@slot.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white">Recent Appointments</div>
            <div class="card-body p-0">
                @if (Model.RecentAppointments.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No appointments.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Company</th><th>Date</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var appointment in Model.RecentAppointments)
                            {
                                <tr>
                                    <td>@appointment.Company?.CompanyName</td>
                                    <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td><partial name="_StatusBadge" model="appointment.Status" /></td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-controller="AdminAppointments"
                                           asp-action="Details"
                                           asp-route-id="@appointment.AppointmentId">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
