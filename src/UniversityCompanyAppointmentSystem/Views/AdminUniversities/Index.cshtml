@model IEnumerable<University>
@{
    ViewData["Title"] = "Universities";
    string? searchTerm = ViewBag.SearchTerm as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Universities</h2>
    <a class="btn btn-brand" asp-action="Create">+ Add University</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search name, email, contact..." />
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-secondary">Search</button></div>
    @if (!string.IsNullOrWhiteSpace(searchTerm))
    {
        <div class="col-auto"><a asp-action="Index" class="btn btn-link">Clear</a></div>
    }
</form>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-3 mb-0">No universities found.</p>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var university in Model)
                    {
                        <tr>
                            <td>@university.UniversityName</td>
                            <td>@university.ContactPersonName</td>
                            <td>@university.Email</td>
                            <td>@university.PhoneNumber</td>
                            <td>@university.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@university.UniversityId">Details</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@university.UniversityId">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
