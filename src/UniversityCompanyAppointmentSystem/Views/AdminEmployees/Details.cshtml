@model Employee
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Model.FullName</h2>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">Employee Details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Company</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="AdminCompanies" asp-action="Details" asp-route-id="@Model.CompanyId">
                            @Model.Company?.CompanyName
                        </a>
                    </dd>
                    <dt class="col-sm-4">Employee #</dt><dd class="col-sm-8">@Model.EmployeeNumber</dd>
                    <dt class="col-sm-4">Civil ID</dt><dd class="col-sm-8">@Model.CivilId</dd>
                    <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.PhoneNumber</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Department</dt><dd class="col-sm-8">@Model.Department</dd>
                    <dt class="col-sm-4">Job Title</dt><dd class="col-sm-8">@Model.JobTitle</dd>
                    <dt class="col-sm-4">Created</dt><dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">Appointments</div>
            <div class="card-body p-0">
                @if (Model.AppointmentEmployees.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No appointments linked.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Reference</th><th>University</th><th>Date</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var link in Model.AppointmentEmployees.OrderByDescending(ae => ae.Appointment?.AppointmentDate))
                            {
                                var appointment = link.Appointment;
                                if (appointment == null) { continue; }
                                <tr>
                                    <td>@appointment.AppointmentReference</td>
                                    <td>@appointment.University?.UniversityName</td>
                                    <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td><partial name="_StatusBadge" model="appointment.Status" /></td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-controller="AdminAppointments"
                                           asp-action="Details"
                                           asp-route-id="@appointment.AppointmentId">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
