@model List<Appointment>
@{
    ViewData["Title"] = "Appointments";
    bool isUniversity = (ViewBag.CurrentAccountType as string) == "University";
}

<h2 class="mb-4">Appointments</h2>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted p-3 mb-0">No appointments yet.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>@(isUniversity ? "Company" : "University")</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Employees</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>@appointment.AppointmentReference</td>
                            <td>@(isUniversity ? appointment.Company?.CompanyName : appointment.University?.UniversityName)</td>
                            <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td>@appointment.StartTime.ToString("hh:mm tt") - @appointment.EndTime.ToString("hh:mm tt")</td>
                            <td>@appointment.AppointmentEmployees.Count</td>
                            <td><partial name="_StatusBadge" model="appointment.Status" /></td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@appointment.AppointmentId">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
