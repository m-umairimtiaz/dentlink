@model AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment Details";
    bool isUniversity = (ViewBag.CurrentAccountType as string) == "University";
    var appointment = Model.Appointment;
}

<h2 class="mb-4">Appointment Details</h2>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4"><strong>Reference Number</strong><div>@appointment.AppointmentReference</div></div>
            <div class="col-md-4"><strong>University</strong><div>@appointment.University?.UniversityName</div></div>
            <div class="col-md-4"><strong>Company</strong><div>@appointment.Company?.CompanyName</div></div>

            <div class="col-md-4"><strong>Appointment Date</strong><div>@appointment.AppointmentDate.ToString("dd MMMM yyyy")</div></div>
            <div class="col-md-4"><strong>Appointment Time</strong><div>@appointment.StartTime.ToString("hh:mm tt") - @appointment.EndTime.ToString("hh:mm tt")</div></div>
            <div class="col-md-4"><strong>Status</strong><div><partial name="_StatusBadge" model="appointment.Status" /></div></div>

            <div class="col-md-4"><strong>Booking Created</strong><div>@appointment.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div></div>
            <div class="col-md-4"><strong>Number of Employees</strong><div>@Model.Employees.Count</div></div>
            <div class="col-md-4"><strong>Last Updated</strong><div>@appointment.UpdatedAt.ToString("dd MMM yyyy, hh:mm tt")</div></div>

            <div class="col-12"><strong>Purpose</strong><div>@appointment.Purpose</div></div>
        </div>

        @if (isUniversity)
        {
            <div class="mt-4 d-flex gap-2">
                @if (appointment.Status == AppointmentStatus.Pending)
                {
                    <form asp-action="Confirm" asp-route-id="@appointment.AppointmentId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success-brand">Confirm Appointment</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@appointment.AppointmentId" method="post"
                          onsubmit="return confirm('Are you sure you want to reject this appointment?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">Reject Appointment</button>
                    </form>
                }
                @if (appointment.Status == AppointmentStatus.Confirmed)
                {
                    <form asp-action="Complete" asp-route-id="@appointment.AppointmentId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-brand">Mark as Completed</button>
                    </form>
                    <form asp-action="Cancel" asp-route-id="@appointment.AppointmentId" method="post"
                          onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">Cancel Appointment</button>
                    </form>
                }
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">Selected Employees</div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead>
                <tr><th>Employee #</th><th>Full Name</th><th>Civil ID</th><th>Phone</th><th>Department</th><th>Job Title</th></tr>
            </thead>
            <tbody>
                @foreach (var employee in Model.Employees)
                {
                    <tr>
                        <td>@employee.EmployeeNumber</td>
                        <td>@employee.FullName</td>
                        <td>@employee.CivilId</td>
                        <td>@employee.PhoneNumber</td>
                        <td>@employee.Department</td>
                        <td>@employee.JobTitle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Appointments</a>
</div>
