@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center pt-4 position-relative dentlink-hero">
    <!-- Logo sits behind the heading as a faint watermark (see .dentlink-hero-logo in site.css) -->
    <img src="~/images/dentlink-logo.svg" alt="" class="dentlink-hero-logo" />
    <div class="position-relative">
        <h1 class="display-6 mb-0" style="color:var(--brand-dark-blue)">Welcome to DentLink</h1>
        <p class="text-muted mb-4">
            Connecting Universities and Companies
        </p>
    </div>
</div>

<!-- Same "choose account type" card used on the Register page, so the home page doubles
     as the registration entry point. A Login link is included for returning users. -->
<div class="auth-card text-center">
    <h3 class="mb-4">Create an Account</h3>
    <p class="text-muted mb-4">Choose the type of account you would like to register.</p>

    <a class="btn btn-brand w-100 mb-3" asp-controller="Account" asp-action="RegisterUniversity">Register as a University</a>
    <a class="btn btn-outline-secondary w-100 mb-3" asp-controller="Account" asp-action="RegisterCompany">Register as a Company</a>

    <hr class="my-4" />

    <p class="mb-0">Already have an account? <a asp-controller="Account" asp-action="Login">Login here</a>.</p>
</div>
