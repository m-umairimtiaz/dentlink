@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

@await Html.PartialAsync("_DentLinkHero")

<div class="auth-card">
    <h3 class="mb-2 text-center">Login</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="sample-login-actions mb-3">
        <p class="small text-muted text-center mb-2">Quick demo login — fill sample details:</p>
        <div class="d-flex flex-wrap gap-2">
            <button type="button"
                    class="btn btn-outline-secondary flex-fill sample-login-btn"
                    data-email="admin@dentlink.com"
                    data-password="Admin@123">
                Admin
            </button>
            <button type="button"
                    class="btn btn-outline-secondary flex-fill sample-login-btn"
                    data-email="admin@ku.edu.kw"
                    data-password="University@123">
                University
            </button>
            <button type="button"
                    class="btn btn-outline-secondary flex-fill sample-login-btn"
                    data-email="hr@gulftech.com"
                    data-password="Company@123">
                Company
            </button>
        </div>
    </div>

    <form asp-action="Login" method="post" id="loginForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-brand w-100">Login</button>
    </form>

    <p class="mt-3 mb-0 text-center">Don't have an account? <a asp-action="Register">Register here</a>.</p>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function () {
            var emailInput = document.getElementById('Email');
            var passwordInput = document.getElementById('Password');
            var buttons = document.querySelectorAll('.sample-login-btn');

            function fillSample(email, password, activeBtn) {
                if (!emailInput || !passwordInput) return;
                emailInput.value = email;
                passwordInput.value = password;
                buttons.forEach(function (btn) {
                    btn.classList.toggle('active', btn === activeBtn);
                });
            }

            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    fillSample(btn.getAttribute('data-email'), btn.getAttribute('data-password'), btn);
                });
            });

            // Pre-fill Admin sample on load so the form is ready immediately.
            if (buttons.length > 0) {
                buttons[0].click();
            }
        })();
    </script>
}
