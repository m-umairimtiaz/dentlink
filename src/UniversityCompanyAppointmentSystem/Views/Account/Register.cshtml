@{
    ViewData["Title"] = "Register";
}

@await Html.PartialAsync("_DentLinkHero")

<div class="auth-card text-center">
    <h3 class="mb-4">Create an Account</h3>
    <p class="text-muted mb-4">Choose the type of account you would like to register.</p>

    <a class="btn btn-brand w-100 mb-3" asp-action="RegisterUniversity">Register as a University</a>
    <a class="btn btn-outline-secondary w-100 mb-3" asp-action="RegisterCompany">Register as a Company</a>

    <p class="mt-3 mb-0">Already have an account? <a asp-action="Login">Login here</a>.</p>
</div>
