@model List<AppointmentSlot>
@{
    ViewData["Title"] = "Appointment Slots";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Appointment Slots</h2>
    <a class="btn btn-brand" asp-action="Create">+ Add Slot</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted p-3 mb-0">No appointment slots yet. Click "Add Slot" to create one.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Maximum Employees</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Model)
                    {
                        <tr class="@(slot.Status == SlotStatus.Unavailable ? "slot-unavailable" : "")">
                            <td>@slot.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td>@slot.StartTime.ToString("hh:mm tt")</td>
                            <td>@slot.EndTime.ToString("hh:mm tt")</td>
                            <td>@slot.MaximumEmployees</td>
                            <td>
                                @if (slot.Status == SlotStatus.Available)
                                {
                                    <span class="badge badge-confirmed">Available</span>
                                }
                                else
                                {
                                    <span class="badge badge-cancelled">Unavailable</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@slot.AppointmentSlotId">Edit</a>
                                <form asp-action="Delete" asp-route-id="@slot.AppointmentSlotId" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this appointment slot?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
